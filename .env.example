# Copy to .env.local (git-ignored) and fill in. Never commit a real token.
#
# Base URL of the Arduino UNO Q telemetry service, as seen FROM THE NEXT.JS
# SERVER. With `npm run unoq:link` the board's App Lab web_ui port is forwarded
# over the authorised USB ADB connection, so this stays on localhost.
#
# Do not put the board's Wi-Fi address here: the venue network isolates
# clients, so that address is not reachable from the laptop.
AEROHALO_UNOQ_URL=http://127.0.0.1:7000

# Controller token, required only for POST /api/command (Manual HOLD, Reset
# after inspection, engine state). The board prints a NEW token every time the
# application starts, so re-read it after each restart:
#
#   npm run unoq:token
#
AEROHALO_UNOQ_TOKEN=

# Optional: port used by scripts/unoq-link.mjs for the adb forward.
# AEROHALO_UNOQ_PORT=7000
